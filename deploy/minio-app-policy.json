{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::wardrobe",
        "arn:aws:s3:::wardrobe/*",
        "arn:aws:s3:::accessories",
        "arn:aws:s3:::accessories/*",
        "arn:aws:s3:::blog",
        "arn:aws:s3:::blog/*",
        "arn:aws:s3:::forum",
        "arn:aws:s3:::forum/*",
        "arn:aws:s3:::results",
        "arn:aws:s3:::results/*"
      ]
    }
  ]
}
