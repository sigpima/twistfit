# Biến dùng ở cấp docker-compose.yml (root). Copy thành .env và điền giá
# trị thật — KHÔNG commit file .env.
# backend/.env và frontend/.env vẫn là 2 file riêng, giữ nguyên như cũ.

# Phải khớp DATABASE_URL trong backend/.env (cùng tên DB, user).
POSTGRES_USER=twistfit
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=twistfit_dev

# Tài khoản root của MinIO — chỉ dùng để chạy minio-init-buckets/
# minio-init-policy lúc khởi tạo, backend không dùng quyền root này nữa.
MINIO_ROOT_USER=twistfit-admin
MINIO_ROOT_PASSWORD=change-me-in-production

# User riêng cho backend, quyền hạn chế theo deploy/minio-app-policy.json
# (chỉ đọc/ghi 5 bucket app dùng, không có quyền admin) — minio-init-policy
# tự tạo user này lúc khởi tạo, tự chọn giá trị ngẫu nhiên đủ dài.
MINIO_APP_ACCESS_KEY=change-me-in-production
MINIO_APP_SECRET_KEY=change-me-in-production

# Domain public browser dùng để PUT/GET trực tiếp vào MinIO qua reverse-proxy
# — phải khớp đúng server_name trong deploy/nginx.conf (SigV4 ký cả Host
# header, xem backend/app/core/blob_storage.py).
MINIO_PUBLIC_ENDPOINT=https://storage.twistfit.org

# Tuỳ chọn — ghim/rollback về 1 bản build cụ thể thay vì luôn :latest.
# Để trống thì mặc định :latest.
# FRONTEND_IMAGE_TAG=
# BACKEND_IMAGE_TAG=
# MINIO_IMAGE_TAG=
